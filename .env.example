# Скопируйте в .env и заполните. Файл .env никому не пересылайте.
# Комментарии только на отдельных строках: docker не понимает их после значения.

# Субдомен из адреса вашего_субдомена.amocrm.ru
AMO_SUBDOMAIN=
# Долгосрочный токен частной интеграции amoCRM
AMO_TOKEN=
# Случайная строка 40+ символов, станет частью адреса коннектора.
# Сгенерировать: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_SECRET=
TIMEZONE=Europe/Moscow
PORT=8000

# --- Заполняются после первого запуска, по ответу get_reference ---
# id доп. поля с каналом заявки, если канал хранится в поле (иначе берётся первый тег)
CHANNEL_FIELD_ID=
# id этапов «замер назначен / проведён», через запятую
MEASURE_STATUS_IDS=
# id этапов «договор», через запятую
CONTRACT_STATUS_IDS=
# Со скольких секунд звонок считается состоявшимся
CALL_OK_SECONDS=20
WORK_HOURS=09:00-19:00
# 1 = пн ... 7 = вс
WORK_DAYS=1,2,3,4,5,6

# --- Изменение данных ---
# 1 = Claude может менять сделки и задачи (с подтверждением), 0 = только чтение
WRITE_ENABLED=1
# Максимум объектов в одном изменении
MAX_BATCH=50
# Журнал всех изменений (папка /data подключается как том)
AUDIT_LOG=/data/audit.log
